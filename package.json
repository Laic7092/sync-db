{
  "name": "sync-db",
  "version": "0.1.0",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/sync-db.cjs",
  "module": "./dist/sync-db.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/sync-db.mjs",
      "require": "./dist/sync-db.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vp build && tsc -p tsconfig.build.json",
    "prepare": "vp config",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plugin-dts": "^4.5.4",
    "vite-plus": "latest"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0",
    "ws": "^8.20.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
